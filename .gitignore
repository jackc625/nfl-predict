# NFL Prediction System - Git Ignore File

# =============================================================================
# ENVIRONMENT & SECRETS
# =============================================================================

# Environment variables (NEVER commit secrets!)
.env
.env.*
!.env.example

# Virtual environment
.venv/
venv/
env/

# =============================================================================
# DATA & OUTPUTS
# =============================================================================

# Data directories (contain large datasets and sensitive information)
data/
!data/.gitkeep

# Model outputs and predictions
outputs/
!outputs/.gitkeep

# Model artifacts and trained models
artifacts/
!artifacts/.gitkeep

# Logs
logs/
*.log

